---
pagination:
  data: releases
  size: 1
  alias: release
permalink: "/{{ release.slug }}/"
layout: base.njk
eleventyComputed:
  title: "TrajDali - {{ release.title }}"
---

<heading>
    <div id="heading-image">
        <img src="/{{ release.coverArt }}" alt="TrajDali - {{ release.title }}" />
    </div>
    <div id="heading-logo">
        <img src="/logo-black.png" alt="TrajDali Logo"{% if release.logoGlow %} class="logo-outline"{% endif %} />
    </div>
</heading>

{% if release.youtubeId %}
<section id="youtube-section">
    <iframe class="mix-embed" src="https://www.youtube.com/embed/{{ release.youtubeId }}?controls=0" title="TrajDali - {{ release.title }}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
</section>
{% endif %}

{% if release.links %}
<section id="additional-links">
    <h2 class="section-heading">Additional links</h2>
    {% for link in release.links %}
    <a href="{{ link.url }}" class="view-all-link">{{ link.label }}</a>
    {% endfor %}
</section>
{% endif %}

<section id="end-of-the-page-room"></section>
